# EmailJS — copy this file to ".env" and paste your real values from https://www.emailjs.com/
# Full setup guide: EMAILJS_SETUP.md
# Restart "npm run dev" after creating or editing .env

VITE_EMAILJS_SERVICE_ID=service_xxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
